# Copy this file to .env and adjust. Every value has a sensible default for local work.
PORT=3000
DB_PATH=data/campus.db

# Required (32+ characters) when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
TOKEN_TTL_HOURS=8

# How long a reset code stays valid
RESET_CODE_MINUTES=30

# SMTP settings for sending password-reset codes. Leave blank for terminal demo mode.
SMTP_HOST=
SMTP_PORT=587 
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Booking rules
BOOKING_MAX_DAYS_AHEAD=30
BOOKING_MIN_MINUTES=15
BOOKING_MAX_MINUTES=240

# Password used by `npm run seed` for the demo accounts (demo data only)
SEED_PASSWORD=Demo@12345
